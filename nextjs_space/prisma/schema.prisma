generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/energenius_website/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
  id                    String   @id @default(cuid())
  model                 String
  sku                   String   @unique
  price                 String
  priceNumeric          Float
  wattage               String
  continuousPower       String
  peakPower             String
  batteryType           String
  batteryCapacity       String
  lifeCycles            String?
  outputVoltage         String
  solarChargeController String?
  acOutlets             String?
  dcPorts               String?
  usbPorts              String?
  weight                String
  dimensions            String
  inverterType          String?
  features              String[]
  description           String
  imageUrl              String
  warranty              String
  category              String
  includedAccessories   String[]
  tier                  String
  application           String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([tier])
  @@index([priceNumeric])
}

model QuoteRequest {
  id                 String    @id @default(cuid())
  name               String
  email              String
  phone              String
  location           String
  projectType        String
  powerNeeds         String
  timeline           String
  message            String?
  status             String    @default("new")
  interestedProducts String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  assignedTo         String?
  closedDate         DateTime?
  estimatedValue     Float?
  followUpDate       DateTime?
  leadSource         String?
  lostReason         String?
  invoices           Invoice[]

  @@index([status])
  @@index([projectType])
  @@index([createdAt])
  @@index([leadSource])
  @@index([assignedTo])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  status       String   @default("active")
  source       String?
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  password             String
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(true)
  teamId               String?
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  role                 UserRole              @default(SUPER_ADMIN)
  accounts             Account[]
  auditLogs            AuditLog[]
  fulfillmentProvider  FulfillmentProvider?
  installations        Installation[]        @relation("AssignedInstaller")
  installationMessages InstallationMessage[]
  installationUpdates  InstallationUpdate[]
  installerProfile     InstallerProfile?
  invoices             Invoice[]
  sessions             Session[]
  teamMember           TeamMember?

  @@index([email])
  @@index([role])
  @@index([teamId])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  quoteRequestId   String?
  customerName     String
  customerEmail    String
  customerPhone    String
  customerAddress  String?
  status           String        @default("draft")
  subtotal         Float
  taxRate          Float         @default(0)
  taxAmount        Float         @default(0)
  totalAmount      Float
  depositAmount    Float?
  depositPaid      Boolean       @default(false)
  depositPaidAt    DateTime?
  balancePaid      Boolean       @default(false)
  balancePaidAt    DateTime?
  paymentMethod    String?
  paymentNotes     String?
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime?
  notes            String?
  internalNotes    String?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  assignedSalesRep String?
  commissionAmount Float?
  commissionRate   Float?        @default(0.15)
  leadSource       String?
  paidDate         DateTime?
  salesCycle       Int?
  createdBy        User          @relation(fields: [createdById], references: [id])
  quoteRequest     QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  items            InvoiceItem[]
  payments         Payment[]

  @@index([status])
  @@index([invoiceNumber])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([assignedSalesRep])
  @@index([leadSource])
  @@index([paidDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productSku  String?
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                      String    @id @default(cuid())
  invoiceId               String
  stripePaymentIntentId   String?   @unique
  stripeCheckoutSessionId String?   @unique
  amount                  Float
  currency                String    @default("usd")
  status                  String    @default("pending")
  paymentType             String
  paymentMethod           String?
  last4                   String?
  brand                   String?
  customerEmail           String
  customerName            String
  description             String?
  paidAt                  DateTime?
  failedAt                DateTime?
  stripeMetadata          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  invoice                 Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
  @@index([customerEmail])
  @@index([createdAt])
}

model Customer {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  phone           String
  company         String?
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingZip      String?
  billingCountry  String?  @default("USA")
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?  @default("USA")
  customerType    String   @default("residential")
  status          String   @default("active")
  taxExempt       Boolean  @default(false)
  taxId           String?
  businessLicense String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]

  @@index([email])
  @@index([status])
  @@index([customerType])
}

model TeamMember {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  role            String    @default("staff")
  department      String?
  status          String    @default("active")
  userId          String?   @unique
  hireDate        DateTime?
  terminationDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([role])
  @@index([status])
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  customerId        String?
  invoiceId         String?        @unique
  invoiceNumber     String?
  status            String         @default("pending")
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  shippingCity      String
  shippingState     String
  shippingZip       String
  shippingCountry   String         @default("USA")
  billingAddress    String
  billingCity       String
  billingState      String
  billingZip        String
  billingCountry    String         @default("USA")
  subtotal          Float
  taxAmount         Float
  totalAmount       Float
  fulfillmentStatus String         @default("pending")
  orderDate         DateTime       @default(now())
  expectedDelivery  DateTime?
  customerNotes     String?
  internalNotes     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  installations     Installation[]
  customer          Customer?      @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  shipments         Shipment[]

  @@index([status])
  @@index([orderNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([fulfillmentStatus])
  @@index([orderDate])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productSku  String
  productName String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productSku])
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  carrier           String
  trackingNumber    String
  trackingUrl       String?
  status            String    @default("pending")
  shippedDate       DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  weight            String?
  dimensions        String?
  packageCount      Int       @default(1)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  subject     String
  body        String
  variables   String?
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([name])
}

model ServicePackage {
  id                String            @id @default(cuid())
  name              String
  category          String            @default("residential")
  price             Float
  bundlePrice       Float?            // Discounted price when bundled with 5,000W+ generator
  priceMonthly      Float?
  currency          String            @default("USD")
  description       String
  bestFor           String?
  deliverables      String[]
  exclusions        String[]
  scopeLimits       String?
  isActive          Boolean           @default(true)
  isPublic          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  displayOrder      Int               @default(0)
  estimatedTimeline String?
  isPopular         Boolean           @default(false)
  packageType       String            @default("one_time")
  slug              String?           @unique
  tagline           String?
  targetWattage     String?
  warrantyInfo      String?
  prerequisites     String[]
  purchases         ServicePurchase[]

  @@index([category])
  @@index([packageType])
  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
}

model ServicePurchase {
  id                    String         @id @default(cuid())
  servicePackageId      String
  customerId            String?
  customerName          String
  customerEmail         String
  customerPhone         String
  customerAddress       String?
  purchasePrice         Float
  subscriptionMonthly   Float?
  status                String         @default("pending")
  acknowledgedTerms     String[]
  acknowledgedAt        DateTime       @default(now())
  projectStartDate      DateTime?
  projectEndDate        DateTime?
  dormancyDate          DateTime?
  paymentStatus         String         @default("unpaid")
  paymentMethod         String?
  stripePaymentIntentId String?        @unique
  subscriptionActive    Boolean        @default(false)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  stripSubscriptionId   String?        @unique
  customerNotes         String?
  internalNotes         String?
  linkedQuoteId         String?
  linkedInvoiceId       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  servicePackage        ServicePackage @relation(fields: [servicePackageId], references: [id])

  @@index([servicePackageId])
  @@index([customerEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([subscriptionActive])
  @@index([createdAt])
}

model SupportTicket {
  id            String              @id @default(cuid())
  ticketNumber  String              @unique
  subject       String
  category      String              @default("general")
  priority      String              @default("medium")
  status        String              @default("open")
  customerName  String
  customerEmail String
  customerPhone String?
  customerId    String?
  description   String
  assignedTo    String?
  tags          String[]
  resolvedAt    DateTime?
  resolvedBy    String?
  resolution    String?
  orderId       String?
  orderNumber   String?
  productSku    String?
  internalNotes String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  attachments   SupportAttachment[]
  replies       SupportReply[]

  @@index([ticketNumber])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([customerEmail])
  @@index([assignedTo])
  @@index([createdAt])
}

model SupportReply {
  id              String        @id @default(cuid())
  ticketId        String
  message         String
  isCustomerReply Boolean       @default(false)
  authorName      String
  authorEmail     String
  isInternal      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model SupportAttachment {
  id              String        @id @default(cuid())
  ticketId        String
  fileName        String
  fileUrl         String
  fileSize        Int
  fileType        String
  uploadedBy      String
  uploadedByEmail String
  createdAt       DateTime      @default(now())
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model KnowledgeBaseArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  category        String    @default("general")
  content         String
  excerpt         String?
  displayOrder    Int       @default(0)
  isPublished     Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  metaDescription String?
  keywords        String[]
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  relatedArticles String[]
  authorName      String?
  lastEditedBy    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([displayOrder])
  @@index([viewCount])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actionType   String
  userId       String
  targetType   String
  targetId     String?
  targetLabel  String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([actionType])
  @@index([targetType])
  @@index([createdAt])
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  token       String    @unique
  status      String    @default("pending")
  invitedBy   String
  inviterName String
  expiresAt   DateTime
  acceptedAt  DateTime?
  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

model FulfillmentProvider {
  id               String                         @id @default(cuid())
  companyName      String
  contactName      String
  contactEmail     String                         @unique
  contactPhone     String?
  userId           String                         @unique
  status           String                         @default("active")
  canUpdateOrders  Boolean                        @default(true)
  canViewAnalytics Boolean                        @default(true)
  notes            String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  assignedProducts FulfillmentProductAssignment[]
  user             User                           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([contactEmail])
}

model FulfillmentProductAssignment {
  id                    String              @id @default(cuid())
  fulfillmentProviderId String
  productSku            String
  productName           String
  isActive              Boolean             @default(true)
  totalOrdersShipped    Int                 @default(0)
  averageShippingDays   Float?
  lastShipmentDate      DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  fulfillmentProvider   FulfillmentProvider @relation(fields: [fulfillmentProviderId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentProviderId, productSku])
  @@index([fulfillmentProviderId])
  @@index([productSku])
  @@index([isActive])
}

model InstallerProfile {
  id                   String   @id @default(cuid())
  companyName          String?
  specialization       String[]
  serviceAreas         String[]
  licenseNumber        String?
  insuranceNumber      String?
  userId               String   @unique
  status               String   @default("active")
  availability         String   @default("available")
  totalJobsCompleted   Int      @default(0)
  averageRating        Float?
  onTimeCompletionRate Float?
  phone                String
  email                String
  emergencyContact     String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([availability])
}

model Installation {
  id                  String                @id @default(cuid())
  installationNumber  String                @unique
  title               String
  description         String
  orderId             String?
  invoiceId           String?
  customerName        String
  customerEmail       String
  customerPhone       String
  installationAddress String
  products            String[]
  productNames        String[]
  assignedInstallerId String?
  assignedBy          String?
  assignedAt          DateTime?
  scheduledDate       DateTime?
  estimatedDuration   Int?
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  status              String                @default("pending")
  progress            Int                   @default(0)
  priority            String                @default("normal")
  jobType             String
  requiresPermit      Boolean               @default(false)
  permitNumber        String?
  completedAt         DateTime?
  completionNotes     String?
  customerSignature   String?
  installerRating     Int?
  customerFeedback    String?
  hasIssues           Boolean               @default(false)
  issueDescription    String?
  photoUrls           String[]
  documentUrls        String[]
  internalNotes       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assignedInstaller   User?                 @relation("AssignedInstaller", fields: [assignedInstallerId], references: [id])
  order               Order?                @relation(fields: [orderId], references: [id])
  messages            InstallationMessage[]
  updates             InstallationUpdate[]

  @@index([installationNumber])
  @@index([status])
  @@index([assignedInstallerId])
  @@index([assignedBy])
  @@index([scheduledDate])
  @@index([orderId])
  @@index([customerEmail])
}

model InstallationUpdate {
  id              String       @id @default(cuid())
  installationId  String
  updateType      String
  title           String
  description     String
  oldStatus       String?
  newStatus       String?
  progressPercent Int?
  photoUrls       String[]
  documentUrls    String[]
  latitude        Float?
  longitude       Float?
  createdById     String
  createdAt       DateTime     @default(now())
  createdBy       User         @relation(fields: [createdById], references: [id])
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@index([createdById])
  @@index([createdAt])
  @@index([updateType])
}

model InstallationMessage {
  id              String       @id @default(cuid())
  installationId  String
  subject         String?
  message         String
  messageType     String       @default("general")
  priority        String       @default("normal")
  isRead          Boolean      @default(false)
  isResolved      Boolean      @default(false)
  senderId        String
  receiverRole    String?
  attachmentUrls  String[]
  parentMessageId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id])

  @@index([installationId])
  @@index([senderId])
  @@index([isRead])
  @@index([isResolved])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  SALES_REP
  OPERATIONS_MANAGER
  MARKETING_SPECIALIST
  VIRTUAL_ASSISTANT
  FULFILLMENT_PROVIDER
  INSTALLER
}
