generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/energenius_website/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
  id                    String   @id @default(cuid())
  model                 String
  sku                   String   @unique
  price                 String
  priceNumeric          Float
  wattage               String
  continuousPower       String
  peakPower             String
  batteryType           String
  batteryCapacity       String
  lifeCycles            String?
  outputVoltage         String
  solarChargeController String?
  acOutlets             String?
  dcPorts               String?
  usbPorts              String?
  weight                String
  dimensions            String
  inverterType          String?
  features              String[]
  description           String   @db.Text
  imageUrl              String
  warranty              String
  category              String
  includedAccessories   String[]
  tier                  String   // Portable, Home, Professional, Commercial, Battery
  application           String[] // residential, commercial, portable, battery
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([tier])
  @@index([priceNumeric])
}

model QuoteRequest {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  location      String   // State
  projectType   String   // Residential or Commercial
  powerNeeds    String   @db.Text
  timeline      String
  message       String?  @db.Text
  status        String   @default("new") // new, contacted, quoted, closed
  interestedProducts String[] // Array of product SKUs
  invoices      Invoice[] // Related invoices
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([projectType])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("new") // new, responded, resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("active") // active, unsubscribed
  source      String?  // homepage, footer, blog, etc.
  subscribedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
}

// Authentication Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          String    @default("admin") // admin, staff
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  invoices      Invoice[] // Invoices created by this user
  teamMember    TeamMember? // Link to team member profile

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Invoice Management Models
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  quoteRequestId  String?       // Optional link to quote request
  quoteRequest    QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  
  // Customer Information
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?       @db.Text
  
  // Invoice Details
  status          String        @default("draft") // draft, sent, paid, cancelled
  subtotal        Float
  taxRate         Float         @default(0)
  taxAmount       Float         @default(0)
  totalAmount     Float
  
  // Payment Tracking
  depositAmount   Float?
  depositPaid     Boolean       @default(false)
  depositPaidAt   DateTime?
  balancePaid     Boolean       @default(false)
  balancePaidAt   DateTime?
  paymentMethod   String?       // ACH, wire_transfer, credit_card, check
  paymentNotes    String?       @db.Text
  
  // Dates
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  
  // Notes
  notes           String?       @db.Text
  internalNotes   String?       @db.Text
  
  // Relations
  items           InvoiceItem[]
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([invoiceNumber])
  @@index([customerEmail])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  productSku  String?  // Link to product if applicable
  description String   @db.Text
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

// Phase 2: Customer Management
model Customer {
  id              String   @id @default(cuid())
  
  // Basic Information
  firstName       String
  lastName        String
  email           String   @unique
  phone           String
  company         String?
  
  // Billing Address
  billingAddress  String?  @db.Text
  billingCity     String?
  billingState    String?
  billingZip      String?
  billingCountry  String?  @default("USA")
  
  // Shipping Address (can be different from billing)
  shippingAddress String?  @db.Text
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?  @default("USA")
  
  // Customer Type & Status
  customerType    String   @default("residential") // residential, commercial
  status          String   @default("active") // active, inactive, prospect
  
  // Tax & Business Information
  taxExempt       Boolean  @default(false)
  taxId           String?  // EIN or Tax ID if applicable
  businessLicense String?  // Document URL if uploaded
  
  // Notes
  notes           String?  @db.Text
  
  // Relations
  orders          Order[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([customerType])
}

// Phase 2: Team Member Management
model TeamMember {
  id            String   @id @default(cuid())
  
  // Basic Information
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  
  // Role & Permissions
  role          String   @default("staff") // admin, staff
  department    String?  // sales, support, fulfillment
  
  // Status
  status        String   @default("active") // active, inactive, pending
  
  // User Association (links to User model for login)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  
  // Employment Details
  hireDate      DateTime?
  terminationDate DateTime?
  
  // Notes
  notes         String?  @db.Text
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
}

// Phase 2: Order Management
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  
  // Customer Link
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  
  // Invoice Link (orders are created from paid invoices)
  invoiceId       String?  @unique
  invoiceNumber   String?
  
  // Order Status Workflow
  status          String   @default("pending") // pending, processing, shipped, delivered, completed, cancelled
  
  // Customer Information (snapshot at time of order)
  customerName    String
  customerEmail   String
  customerPhone   String
  
  // Shipping Address
  shippingAddress String   @db.Text
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingCountry String   @default("USA")
  
  // Billing Address
  billingAddress  String   @db.Text
  billingCity     String
  billingState    String
  billingZip      String
  billingCountry  String   @default("USA")
  
  // Order Totals
  subtotal        Float
  taxAmount       Float
  totalAmount     Float
  
  // Fulfillment
  fulfillmentStatus String @default("pending") // pending, processing, shipped, delivered
  
  // Dates
  orderDate       DateTime @default(now())
  expectedDelivery DateTime?
  
  // Notes
  customerNotes   String?  @db.Text
  internalNotes   String?  @db.Text
  
  // Relations
  items           OrderItem[]
  shipments       Shipment[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([orderNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([fulfillmentStatus])
  @@index([orderDate])
}

// Phase 2: Order Items
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Product Information (snapshot at time of order)
  productSku  String
  productName String
  description String   @db.Text
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  
  // Fulfillment Status per item
  status      String   @default("pending") // pending, processing, shipped, delivered
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([productSku])
}

// Phase 2: Shipment Tracking
model Shipment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Carrier Information
  carrier           String   // UPS, FedEx, USPS, etc.
  trackingNumber    String
  trackingUrl       String?
  
  // Shipment Status
  status            String   @default("pending") // pending, in_transit, delivered, returned
  
  // Dates
  shippedDate       DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  
  // Package Information
  weight            String?
  dimensions        String?
  packageCount      Int      @default(1)
  
  // Notes
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

// Phase 2: Email Templates
model EmailTemplate {
  id          String   @id @default(cuid())
  
  // Template Information
  name        String   @unique // e.g., "powerx_order_notification", "customer_order_confirmation"
  category    String   // supplier, customer, internal
  subject     String
  body        String   @db.Text
  
  // Template Variables (JSON string of available variables)
  variables   String?  @db.Text // JSON: ["orderNumber", "customerName", "items", etc.]
  
  // Status
  isActive    Boolean  @default(true)
  
  // Notes
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([name])
}
