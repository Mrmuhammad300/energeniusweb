        "notes": "Service entrance, meter socket, disconnects, utility-side tap."
      },
      {
        "canonical_sku": "SVC-NEC-GROUND",
        "type": "professional_service",
        "display_name": "Grounding & NEC Compliance Package",
        "pricing": { "min": 2000, "default": 3500, "max": 6000, "pricing_type": "range_with_default" },
        "notes": "Ground rods, bonding, conduit, NEC corrections."
      },
      {
        "canonical_sku": "SVC-AHJ-INSPECT",
        "type": "professional_service",
        "display_name": "Coordination with AHJ + Inspections",
        "pricing": { "min": 800, "default": 1500, "max": 3000, "pricing_type": "range_with_default" },
        "notes": "Permits, callbacks, documentation, punch list fixes."
      }
    ]
  },

  "service_range_selection": {
    "selection_methods": [
      { "id": "default_midpoint", "description": "Use curated default field." },
      { "id": "low_medium_high", "description": "Map user selection to min/default/max." }
    ],
    "low_medium_high_mapping": { "low": "min", "medium": "default", "high": "max" }
  },

  "rulesets": {
    "active_ruleset_id": "RULESET_CORE_V1",
    "rules": [
      {
        "rule_id": "HARDWARE_COMMISSION_TIERED",
        "type": "commission",
        "eval_order": ["GEN_HW_OVER_25K_40", "GEN_HW_DEFAULT_15"]
      },
      {
        "rule_id": "TURNKEY_DEFAULT_GTE_10KW",
        "type": "policy",
        "if": { "capacity_kw_gte": 10 },
        "then": { "auto_add_line_item": "INST-TURNKEY" },
        "notes": "Turnkey install default for >=10kW."
      },
      {
        "rule_id": "TURNKEY_REMOVAL_REQUIRES_WAIVER",
        "type": "policy",
        "if": { "capacity_kw_gte": 10, "install_removed": true },
        "then": {
          "require_waiver": {
            "waiver_id": "INSTALL_EXCLUDED_ACK",
            "waiver_text": "Installation excluded. Customer acknowledges electrical integration, permitting, inspections, and code compliance are not included and must be handled by a licensed contractor."
          }
        }
      },
      {
        "rule_id": "INSTALL_DISCOUNT_REQUIRES_LABOR_AND_MATERIALS_FLOOR",
        "type": "guardrail",
        "if": { "install_discount_applied": true },
        "then": {
          "require_assertions": [
            "labor_costs_fully_covered == true",
            "materials_must_be_fully_covered == true"
          ],
          "on_fail": { "action": "REQUIRES_APPROVAL", "approver_role": "sales_manager" }
        }
      },
      {
        "rule_id": "APPROVAL_THRESHOLD_DISCOUNTS",
        "type": "approval_threshold",
        "thresholds": {
          "hardware_discount_pct": 0.1,
          "install_discount_pct": 0.2,
          "services_discount_pct": 0.0
        }
      }
    ]
  },

  "calculator": {
    "sizing_methods": [
      {
        "id": "sqft",
        "display_name": "Square Feet",
        "inputs": ["square_feet", "coverage_tier"],
        "baseline_w_per_sqft": 3.5,
        "coverage_multipliers": { "essential": 0.6, "partial": 0.85, "whole": 1.0 },
        "formula": "estimated_watts = square_feet * baseline_w_per_sqft * coverage_multiplier"
      },
      {
        "id": "acreage",
        "display_name": "Acreage",
        "inputs": ["acres", "coverage_tier"],
        "watts_per_acre_default": 15246,
        "coverage_multipliers": { "essential": 0.6, "partial": 0.85, "whole": 1.0 },
        "formula": "estimated_watts = acres * watts_per_acre_default * coverage_multiplier",
        "notes": "Replace watts_per_acre_default with final acreage baseline."
      },
      {
        "id": "devices",
        "display_name": "Devices",
        "inputs": ["device_list"],
        "formula": "estimated_watts = SUM(device_list.watts_running) + surge_buffer_watts",
        "surge_buffer_watts_default": 0
      }
    ],
    "recommendation_logic": {
      "match_priority": [
        "continuous_w_capacity_primary",
        "peak_w_if_provided",
        "battery_kwh_if_available",
        "ah_plus_voltage_to_kwh_if_available",
        "name_parsing_fallback",
        "manual_override"
      ],
      "capacity_primary": { "match_if_within_pct": 0.02, "buffer_pct_default": 0.1 },
      "selection_rule": "return_smallest_sku_where_continuous_w_gte_required",
      "tie_breakers": [
        "prefer EnerGenius when within 5% of continuous_w",
        "prefer items with warranty years provided",
        "prefer items with peak_w provided"
      ],
      "kwh_computation": {
        "formula": "(capacity_ah * nominal_v) / 1000",
        "requires_fields": ["capacity_ah", "nominal_v"]
      }
    }
  },

  "sku_xref_mapping_engine": {
    "match_priority_order": [
      "continuous_w_within_pct",
      "continuous_w_exact",
      "kwh_if_available",
      "ah_plus_voltage_to_kwh",
      "name_token_numeric_match",
      "manual_override"
    ],
    "rules": {
      "continuous_w_within_pct": { "pct_threshold": 0.02, "confidence": 0.95 },
      "kwh_if_available": { "kwh_threshold_pct": 0.05, "confidence": 0.9 },
      "ah_plus_voltage_to_kwh": { "formula": "(capacity_ah * nominal_v) / 1000", "confidence": 0.85 },
      "name_token_numeric_match": { "numeric_extraction_regex": "(\\d{3,5})\\s*(w|kw|k)", "confidence": 0.7 },
      "manual_override": { "confidence": 1.0 }
    },
    "exclusive_handling": {
      "if_exclusive_to_rrg_energenius_true": "do_not_require_vendor_xref"
    }
  },

  "pricing_engine": {
    "quote_totals_formula": {
      "hardware_total": "SUM(line_items where type == 'generator_hardware' => unit_price * quantity)",
      "installation_total": "SUM(line_items where type == 'installation_package' => unit_price * quantity)",
      "services_total": "SUM(line_items where type == 'professional_service' => unit_price * quantity)",
      "subtotal": "hardware_total + installation_total + services_total"
    },
    "itc": {
      "enabled": true,
      "default_pct": 0.3,
      "eligible_item_types": ["generator_hardware", "eligible_accessory"],
      "ineligible_item_types": ["professional_service", "installation_package"],
      "net_total_formula": "subtotal - (SUM(eligible_item_types) * itc_pct)"
    },
    "commissions": {
      "rule_eval_order": ["GEN_HW_OVER_25K_40", "GEN_HW_DEFAULT_15"],
      "formula": "SUM(generator_hardware => extended_price * commission_pct_for_line)"
    },
    "guardrails": {
      "turnkey_default_for_capacity_kw_gte": 10,
      "allow_installation_discounts_only_if": [
        "hardware_margin_intact == true",
        "labor_costs_fully_covered == true"
      ],
      "customer_ack_required_if_install_removed_for_kw_gte": 10,
      "on_violation": {
        "action": "REQUIRE_APPROVAL",
        "approval_roles": ["sales_manager", "master_admin"]
      }
    }
  },

  "multi_unit_install_discount_logic": {
    "install_pricing_breakdown": {
      "mobilization_fixed": {
        "default_amount": 1750,
        "discountable": true,
        "discount_notes": "Can be spread across units."
      },
      "per_unit_labor": {
        "default_amount": 2400,
        "discountable": true,
        "max_discount_pct": 0.2
      },
      "per_unit_materials_allowance": {
        "default_amount": 850,
        "discountable": false,
        "discount_notes": "Materials floor protected."
      },
      "compliance_admin": {
        "default_amount": 750,
        "discountable": true,
        "max_discount_pct": 0.15
      }
    },
    "multi_unit_discount_rules": [
      {
        "rule_id": "MOBILIZATION_SPREAD",
        "if_quantity_gte": 2,
        "then": { "allocate_mobilization_formula": "mobilization_fixed / quantity" }
      },
      {
        "rule_id": "LABOR_EFFICIENCY_TIER_3",
        "if_quantity_gte": 3,
        "then": { "target": "per_unit_labor", "discount_pct": 0.1, "cap_pct": 0.2 }
      },
      {
        "rule_id": "LABOR_EFFICIENCY_TIER_5",
        "if_quantity_gte": 5,
        "then": { "target": "per_unit_labor", "discount_pct": 0.15, "cap_pct": 0.2 }
      }
    ],
    "hard_floors": {
      "materials_must_be_fully_covered": true,
      "minimum_install_gross_margin_pct": 0.25
    }
  },

  "line_item_pricing_overrides": {
    "allowed_override_fields": ["unit_price_override", "quantity_override", "note"],
    "override_permissions": {
      "unit_price_override": ["master_admin", "sales_manager"],
      "quantity_override": ["master_admin", "sales_manager", "rep", "dealer_admin", "dealer_rep"]
    },
    "audit_log_required": true
  },

