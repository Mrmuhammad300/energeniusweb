  "lead_capture": {
    "fields": [
      "first_name",
      "last_name",
      "email",
      "phone",
      "company",
      "site_address",
      "state",
      "customer_type",
      "estimated_watts",
      "recommended_skus",
      "quantity_intent",
      "timeline",
      "notes"
    ],
    "webhook": { "endpoint": "/api/leads/ingest", "method": "POST" }
  },

  "assessment_sharing": {
    "method": "signed_share_token",
    "token": {
      "type": "jwt",
      "claims": ["assessment_id", "allowed_brand", "expires_at"],
      "default_ttl_days": 7
    },
    "routes": {
      "create_share_link": "/api/assessments/share",
      "view_shared": "/assessment/shared?token={token}"
    }
  },

  "api_contract": {
    "endpoints": {
      "GET /api/catalog/skus": {
        "query": ["brand", "min_continuous_w", "max_continuous_w", "category", "exclusive_only"],
        "returns": "catalog.products[]"
      },
      "POST /api/assessments/compute": {
        "in": {
          "method": "sqft|acreage|devices",
          "square_feet": 0,
          "acres": 0,
          "device_list": [{ "name": "string", "watts_running": 0, "watts_surge": 0 }],
          "coverage_tier": "essential|partial|whole",
          "state": "string",
          "overage_buffer_pct": 0.1,
          "brand_origin": "RRG|ENERGENIUS",
          "source_channel": "public_web|crm|dealer_portal"
        },
        "out": {
          "assessment_id": "uuid",
          "estimated_watts": 0,
          "recommended_kw": 0,
          "recommended_skus": [{ "canonical_sku": "string", "confidence": 0.0, "why": "string" }],
          "complexity_score": 0.0,
          "warnings": ["string"]
        }
      },
      "GET /api/assessments/{assessment_id}": { "returns": "assessment object" },
      "POST /api/assessments/share": {
        "in": { "assessment_id": "uuid", "allowed_brand": "RRG|ENERGENIUS", "ttl_days": 7 },
        "out": { "share_token": "string", "share_url": "string" }
      },
      "POST /api/leads/ingest": {
        "in": {
          "brand_owner": "RRG|ENERGENIUS",
          "contact": {
            "first_name": "string",
            "last_name": "string",
            "email": "string",
            "phone": "string",
            "company": "string"
          },
          "site_address": "string",
          "state": "string",
          "customer_type": "residential|commercial",
          "quantity_intent": "string|number",
          "timeline": "string",
          "notes": "string",
          "assessment_id": "uuid",
          "attribution": { "source": "string", "campaign": "string", "medium": "string" }
        },
        "out": { "lead_id": "uuid" }
      },
      "POST /api/fulfillment/create": {
        "in": {
          "assessment_id": "uuid",
          "lead_id": "uuid",
          "brand_owner": "RRG|ENERGENIUS",
          "recommended_sku": "canonical_sku",
          "quantity": 1,
          "install_preference": "turnkey|hardware_only|needs_site_verification",
          "selected_packages": ["canonical_sku"],
          "selected_services": ["canonical_sku"],
          "notes": "string",
          "assigned_user_id": "uuid"
        },
        "out": { "request_id": "uuid" }
      },
      "POST /api/quote/build": {
        "in": {
          "pricing_mode": "retail|rep|dealer",
          "customer_type": "residential|commercial",
          "state": "string",
          "assessment_id": "uuid",
          "selected_lines": [
            {
              "canonical_sku": "string",
              "type": "generator_hardware|installation_package|professional_service",
              "quantity": 1
            }
          ],
          "discounts": {
            "hardware_pct": 0.0,
            "install_pct": 0.0,
            "services_pct": 0.0,
            "reason": "string"
          },
          "actor": {
            "role_id": "rep|dealer_rep|sales_manager|brand_admin|master_admin",
            "actor_id": "uuid"
          }
        },
        "out": {
          "quote_id": "uuid",
          "approval": {
            "status": "NOT_REQUIRED|PENDING|APPROVED|REJECTED",
            "reasons": ["string"],
            "approver_role": "sales_manager|master_admin"
          },
          "totals": {
            "hardware_total": 0,
            "installation_total": 0,
            "services_total": 0,
            "subtotal": 0,
            "itc_estimate": 0,
            "net_total_after_itc": 0
          },
          "commission": {
            "total_commission": 0,
            "line_item_commissions": []
          }
        }
      }
    }
  },

  "crm_build_sequence": {
    "architecture": "single_shared_core_backend_two_frontends",
    "steps": [
      {
        "step": 1,
        "name": "Create Core backend",
        "deliverables": [
          "DB tables/collections: assessment, lead, fulfillment_request, sku, ruleset, audit_log",
          "Load catalog + ruleset from this JSON",
          "Implement RBAC with JWT claims"
        ]
      },
      {
        "step": 2,
        "name": "Implement assessment compute endpoint",
        "deliverables": [
          "POST /api/assessments/compute",
          "Server-side compute + persist Assessment",
          "Recommend SKUs using capacity-first logic"
        ]
      },
      {
        "step": 3,
        "name": "Build calculator widget once",
        "deliverables": [
          "UI methods: sqft, acreage, devices",
          "Coverage tier selection",
          "Calls /api/assessments/compute",
          "Renders SKU recommendations"
        ]
      },
      {
        "step": 4,
        "name": "Embed widget into both sites",
        "deliverables": [
          "RRG embed config: RRG_PUBLIC_ASSESSMENT",
          "EnerGenius embed config: ENERGENIUS_PUBLIC_CALCULATOR",
          "Same API, same math"
        ]
      },
      {
        "step": 5,
        "name": "Add assessment sharing (RRG <> EnerGenius)",
        "deliverables": [
          "POST /api/assessments/share",
          "Tokenized shared-view route",
          "Open assessment created in one brand inside the other"
        ]
      },
      {
        "step": 6,
        "name": "Build Master Admin panel on rrg-solutions.com",
        "deliverables": [
          "Global dashboard (cross-brand)",
          "Assessment inbox + filters + assignment",
          "Catalog manager (SKU + xrefs)",
          "Ruleset publish/rollback",
          "Audit log viewer"
        ]
      },
      {
        "step": 7,
        "name": "Add lead ingest + routing",
        "deliverables": [
          "/api/leads/ingest webhooks from both sites",
          "Assignment to reps/dealers by brand_owner",
          "Convert Assessment -> FulfillmentRequest when ready"
        ]
      },
      {
        "step": 8,
        "name": "Add quote builder later (optional)",
        "deliverables": [
          "POST /api/quote/build",
          "Approval routing + discount guardrails",
          "PDF/e-sign/payment link outputs"
        ]
      }
    ]
  },

